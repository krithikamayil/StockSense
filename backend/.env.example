# StockSense Backend Environment Configuration Template
# Copy this file to .env and configure with your local credentials

# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=stocksense
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@127.0.0.1:5432/stocksense

# JWT Authentication Secret (Use a strong secret in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32chars_or_more

# Python AI Service URL (FastAPI running on port 8000)
AI_SERVICE_URL=http://127.0.0.1:8000
